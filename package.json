{
  "name": "@actview/ui",
  "version": "0.1.0",
  "description": "actview 组件注册表 CLI：registry + build 生成 styles，CLI 将组件落到用户侧（shadcn build-registry 复刻，框架层 actview）",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "actview-ui": "bin/actview-ui.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./styles/*": "./styles/*",
    "./registry": "./registry/bases/base/registry.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "registry",
    "styles"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "cli": "node bin/actview-ui.js",
    "typecheck": "tsc --noEmit && tsc -p site/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:react-ref": "vitest run --config vitest.react.config.ts",
    "site:dev": "actview-press dev site",
    "site:build": "actview-press build site",
    "site:preview": "actview-press preview site",
    "prepublishOnly": "node scripts/build.mjs && pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "@actview/base-ui": "0.1.0",
    "@actview/core": "1.1.0",
    "@actview/jsx": "1.1.0",
    "@actview/lucide": "^0.0.1",
    "@actview/plugin-vite": "1.1.1",
    "@actview/press": "1.0.20",
    "@actview/testing": "0.1.1",
    "@base-ui/react": "1.6.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "actview": "1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "happy-dom": "^20.11.2",
    "lucide-react": "^1.31.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
