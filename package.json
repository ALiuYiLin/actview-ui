{
  "name": "@actview/ui",
  "version": "0.1.0",
  "description": "actview 组件注册表 CLI：registry + build 生成 styles，CLI 将组件落到用户侧（shadcn build-registry 复刻，框架层 actview）",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "actview-ui": "bin/actview-ui.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./styles/*": "./styles/*",
    "./registry": "./registry/bases/base/registry.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "registry",
    "styles"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "install:demo": "node bin/actview-ui.js add button-group --style base-aurora --cwd user-project",
    "cli": "node bin/actview-ui.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node scripts/build.mjs && npm run typecheck"
  },
  "dependencies": {},
  "devDependencies": {
    "@actview/core": "^1.0.34",
    "@actview/jsx": "^1.0.17",
    "@actview/lucide": "^0.0.1",
    "actview": "^1.0.29",
    "class-variance-authority": "^0.7.1",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5.7.0"
  }
}
