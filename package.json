{
  "name": "@actview/ui",
  "version": "0.1.0",
  "description": "actview 组件注册表 CLI：registry + build 生成 styles，CLI 将组件落到用户侧（shadcn build-registry 复刻，框架层 actview）",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "actview-ui": "bin/actview-ui.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./styles/*": "./styles/*",
    "./registry": "./registry/bases/base/registry.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "registry",
    "styles"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "cli": "node bin/actview-ui.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node scripts/build.mjs && pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "@actview/core": "^1.0.36",
    "@actview/jsx": "^1.0.17",
    "@actview/lucide": "^0.0.1",
    "@actview/plugin-vite": "^1.0.18",
    "@actview/testing": "^0.0.3",
    "@types/node": "^26.2.0",
    "actview": "^1.0.29",
    "class-variance-authority": "^0.7.1",
    "happy-dom": "^20.11.2",
    "tailwind-merge": "^3.6.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
