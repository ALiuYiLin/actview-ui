{
  "name": "@actview/base-ui",
  "version": "0.1.0",
  "description": "actview 无头交互原语库：复刻 Base UI 的 API 面与 DOM 契约（shadcn v4 base registry 的框架层依赖）",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "node ../scripts/build-base-ui.mjs && tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@actview/core": ">=1.0.36",
    "@actview/jsx": ">=1.0.17"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      }
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.tsx"
  }
}
